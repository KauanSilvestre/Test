    <string name="kcam_quick_samsung_title">Samsung (recommended)</string>
    <string name="kcam_quick_samsung_steps">Settings → Advanced features → Side key → Double press → Open app → choose "Sentinela Rec". Pressing twice again stops the recording.</string>
    <string name="kcam_quick_other_title">Pixel and other phones</string>
    <string name="kcam_quick_other_steps">If your phone has "Double press power button to open camera", choose Sentinela Rec as the camera when asked (or as default camera). Otherwise enable the experimental power-button detection above, or use the home-screen button.</string>
