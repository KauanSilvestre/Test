    <!-- FadCrypt -->
    <string name="kcam_crypt_menu">Encrypt (FadCrypt)</string>
    <string name="kcam_crypt_pick">Choose files to encrypt</string>
    <string name="kcam_crypt_info">Files are encrypted on the phone with AES-256-GCM using a key derived from your password (PBKDF2). There is NO way to recover a forgotten password. Encrypted files are kept in FadCam/Encrypted; decrypted copies go to FadCam/Decrypted.</string>
