<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        As gravações são evidência pessoal e privada. Não devem sair do
        aparelho por backup na nuvem nem por transferência device-to-device.
    -->
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
